[Unit]
Description=llama.cpp HTTP server (LLM inference)
Documentation=https://github.com/ggml-org/llama.cpp
After=network.target

[Service]
Type=simple
EnvironmentFile=-/etc/default/llama-server
ExecStart=/usr/bin/llama-server --host ${LLAMA_HOST} --port ${LLAMA_PORT} -m ${LLAMA_MODEL} ${LLAMA_EXTRA_ARGS}
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
